# Cap-to-Community — server-side environment (sanitized example).
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must NEVER
# be committed. These variables are read ONLY by the server (Vite dev
# middleware + server/index.mjs). They are NOT prefixed VITE_ and are therefore
# never inlined into the client bundle or exposed to the browser.

# Your Google AI Studio (Gemini API) key, used to call Gemma. Keep it secret.
# Server-side only. Create/revoke keys at https://aistudio.google.com/apikey
# Replace the placeholder below with your real key in `.env` (never here).
GEMMA_API_KEY=REPLACE_WITH_YOUR_GOOGLE_AI_STUDIO_KEY

# Optional: pin a specific documented Gemma model on Google AI Studio.
# Defaults to gemma-4-26b-a4b-it if unset. Verified 2026-10-24 via ListModels:
# the generateContent-capable Gemma models were gemma-4-26b-a4b-it and
# gemma-4-31b-it; the older gemma-3-27b-it returns HTTP 404 (not supported for
# generateContent). Confirm the exact model ID available to YOUR key.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional: port for the standalone production server (server/index.mjs).
# PORT=8787
